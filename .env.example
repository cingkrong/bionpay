# ==========================================
# BIONPAY UNIFIED QRIS GATEWAY CONFIGURATION
# Dual Provider: GoPay / GoBiz + ShopeePay Partner
# ==========================================

# Server & Security
PORT=3000
API_KEY=bionpay_secret_api_key_2026
SANDBOX_MODE=false

# ------------------------------------------
# PROVIDER 1: GOPAY / GOBIZ
# ------------------------------------------
# String QRIS Statis cetak dari GoPay / GoBiz (format EMVCo diawali 000201...)
QRIS_STATIC=00020101021126600014ID.GO-JEK.WWW011893600914300000000002150000000000000000303UME51440014ID.GO-JEK.WWW02150000000000000000303UME5204549953033605802ID5914TOKO CONTOH6007JAKARTA61051234062070703A016304ABCD
GOPAY_MERCHANT_ID=
GOPAY_MERCHANT_NAME=TOKO CONTOH
GOPAY_MERCHANT_CITY=JAKARTA

# ------------------------------------------
# PROVIDER 2: SHOPEEPAY PARTNER
# ------------------------------------------
# Token otentikasi merchant web ShopeePay (didapat dari devtools inspect network request get-transaction-list, diawali B:...)
SHOPEE_TOKEN=B:v1:eyJhbGciOi...

# String QRIS Statis cetak dari ShopeePay (format EMVCo, opsional jika ingin template ShopeePay khusus)
SHOPEE_QRIS_STATIC=

# ------------------------------------------
# NOTIFIKASI TELEGRAM (OPSIONAL)
# ------------------------------------------
# Notifikasi jika token ShopeePay kadaluarsa atau terjadi kendala sinkronisasi
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
